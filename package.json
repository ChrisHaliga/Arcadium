{
  "name": "arcadium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start:server": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/fredoka": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8",
    "ws": "^8.22.0"
  }
}
